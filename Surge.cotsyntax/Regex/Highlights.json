{
  "keywords": [
    {
      "begin": "(?:^[ \\t]*|(?<=[(,])[ \\t]*)(?:DOMAIN(?:-SUFFIX|-KEYWORD|-WILDCARD|-SET)?|IP-CIDR6?|IP-ASN|GEOIP|USER-AGENT|URL-REGEX|PROCESS-NAME|DEST-PORT|SRC-PORT|IN-PORT|SRC-IP|DEVICE-NAME|MAC-ADDRESS|PROTOCOL|HOSTNAME-TYPE|SUBNET|CELLULAR-RADIO|CELLULAR-CARRIER|AND|OR|NOT|SCRIPT|RULE-SET|FINAL)(?=[ \\t]*,)",
      "regularExpression": true,
      "description": "Rule types and nested logical conditions"
    }
  ],
  "commands": [
    {
      "begin": "(?<!\\S)(?:#!|//!)[A-Za-z][A-Za-z0-9_-]*",
      "regularExpression": true,
      "description": "Profile directives and module metadata"
    },
    {
      "begin": "(?<![\\w-])(?:http-request(?:-jq)?|http-response(?:-jq)?|header-add|header-del|header-replace(?:-regex)?)(?![\\w-])",
      "regularExpression": true,
      "description": "Rewrite actions and directions"
    }
  ],
  "types": [
    {
      "begin": "^[ \\t]*\\[[^\\]\\r\\n]+\\]",
      "regularExpression": true,
      "description": "Sections, including named WireGuard, Tailscale, and Ruleset sections"
    },
    {
      "begin": "(?<==)[ \\t]*(?:direct|http|https|socks5(?:-tls)?|ss|snell|trojan|vmess|tuic(?:-v5)?|hysteria2|wireguard|ssh|external|select|url-test|fallback|load-balance|smart|subnet)(?=[ \\t]*(?:,|$))",
      "regularExpression": true,
      "description": "Proxy and policy group types"
    }
  ],
  "attributes": [
    {
      "begin": "(?<![\\w.-])[A-Za-z][A-Za-z0-9_-]*(?=[ \\t]*=)",
      "regularExpression": true,
      "description": "Setting names and named parameters"
    },
    {
      "begin": "(?<=[,=])[ \\t]*(?:no-resolve|dns-failed|extended-matching|pre-matching|requires-resolve)(?=[ \\t]*(?:,|$))",
      "regularExpression": true,
      "description": "Rule flags"
    }
  ],
  "variables": [
    {
      "begin": "\\{\\{\\{[^}\\r\\n]+\\}\\}\\}",
      "regularExpression": true,
      "description": "Module argument placeholders"
    },
    {
      "begin": "\\$(?:[0-9]+)",
      "regularExpression": true,
      "description": "Rewrite capture references"
    }
  ],
  "values": [
    {
      "begin": "(?<=[,=])[ \\t]*(?:DIRECT|REJECT(?:-DROP|-NO-DROP|-TINYGIF)?|RECENT|true|false)(?=[ \\t]*(?:,|$|#|;|//))",
      "regularExpression": true,
      "description": "Built-in policies and boolean values"
    }
  ],
  "numbers": [
    {
      "begin": "(?<=[,=])[ \\t]*-?[0-9]+(?:\\.[0-9]+)?(?=[ \\t]*(?:,|$|#|;|//))",
      "regularExpression": true,
      "description": "Numeric parameter values"
    },
    {
      "begin": "(?<![\\w.])(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?:/[0-9]{1,2})?(?![\\w.])",
      "regularExpression": true,
      "description": "IPv4 addresses and network ranges"
    }
  ],
  "comments": [
    {
      "begin": "^[ \\t]*(?:#(?![!])|;|//(?![!]))[^\\r\\n]*",
      "regularExpression": true,
      "description": "Comment lines; exclude profile and module directives"
    }
  ]
}
